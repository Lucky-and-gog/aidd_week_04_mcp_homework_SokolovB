{
  "$version": 4,
  "modelProviders": {
    "openai": [
      {
        "id": "agentic/gc_v3",
        "name": "agentic/gc_v3",
        "baseUrl": "https://llmhub.sberai-rnd.ru/v1",
        "envKey": "MODEL_API_KEY",
        "generationConfig": {
          "samplingParams": {
            "temperature": 0.8,
            "top_p": 0.95,
            "max_tokens": 65536
          }
        }
      }
    ]
  },
  "security": {
    "auth": {
      "selectedType": "openai"
    }
  },
  "context": {
    "fileName": ["QWEN.md"]
  },
  "memory": {
    "enableManagedAutoMemory": false,
    "enableManagedAutoDream": false
  },
    "hooks": {
    "PreToolUse": [
      {
        "matcher": "^run_shell_command$",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$QWEN_PROJECT_DIR/.qwen/hooks/guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "todo": {
      "command": "/opt/homebrew/Caskroom/miniconda/base/envs/aidd-mcp/bin/python",
      "args": ["/Users/lucky/aidd_week_04_mcp/practice/mcp/server.py"],
      "env": { 
        "TODO_API_URL": "http://127.0.0.1:5000",
        "TODO_DELETE_WITHOUT_ELICITATION": "1"
      }
    },
    "excel": {
      "command": "uvx",
      "args": ["excel-mcp-server", "stdio"]
    }
  }
}